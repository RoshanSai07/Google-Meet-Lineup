rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "photoURL",
          "role",
          "createdAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "candidate"
        && request.resource.data.createdAt == request.time;

      // User/admin management belongs to super admins.
      allow update, delete: if isSuperAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();

      // Session management belongs to super admins.
      allow create, update, delete: if isSuperAdmin();

      match /queue/{userId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "name",
            "email",
            "joinedAt",
            "status"
          ])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "waiting"
          && request.resource.data.joinedAt == request.time;

        // Admins operate interviews.
        // Super admins are included in isAdmin().
        //
        // Candidates may only perform the specific:
        // skipped -> waiting (rejoin) transition.
        allow update: if isAdmin()
          || (
            isOwner(userId)
            && resource.data.status == "skipped"
            && request.resource.data.status == "waiting"
            && request.resource.data.joinedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "joinedAt",
              "nextAt",
              "interviewStartedAt",
              "completedAt",
              "skippedAt"
            ])
          );

        // Candidate can leave their own queue.
        // Only super admins can forcibly remove another candidate.
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      match /public/{documentId} {
        allow read: if signedIn();

        // Normal admins need this because queue operations currently
        // call syncPublicLiveState().
        allow create, update, delete: if isAdmin();
      }
    }
  }
}